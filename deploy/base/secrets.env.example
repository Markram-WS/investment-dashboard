# Copy to deploy/base/secrets.env (gitignored) and replace every placeholder-value before applying.
POSTGRES_USER=investment_user
POSTGRES_PASSWORD=placeholder-value-change-me
POSTGRES_DB=investment_main
AI_POSTGRES_USER=ai_user
AI_POSTGRES_PASSWORD=placeholder-value-change-me
AI_POSTGRES_DB=investment_ai
DATABASE_URL=postgresql+asyncpg://investment_user:placeholder-value-change-me@postgres-main:5432/investment_main
AI_DATABASE_URL=postgresql+asyncpg://ai_user:placeholder-value-change-me@postgres-ai:5432/investment_ai
FERNET_KEY=placeholder-value-urlsafe-base64-32-bytes=
