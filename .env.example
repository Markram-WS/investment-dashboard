# ============================================
# Investment Dashboard — Environment Variables
# ============================================
VITE_API_BASE_URL=http://backend:8000/api/v1

# Frontend
NODE_ENV=development

# Backend
PYTHONUNBUFFERED=1

# Database — Main
DATABASE_URL=postgresql+asyncpg://investment_user:investment_pass@investment_db_main:5432/investment_main

# Database — AI
AI_DATABASE_URL=postgresql+asyncpg://ai_user:ai_pass@investment_db_ai:5432/investment_ai

# PostgreSQL — Main DB
POSTGRES_USER=investment_user
POSTGRES_PASSWORD=investment_pass
POSTGRES_DB=investment_main

# PostgreSQL — AI DB
AI_POSTGRES_USER=ai_user
AI_POSTGRES_PASSWORD=ai_pass
AI_POSTGRES_DB=investment_ai
